    "# QDA: separate covariances per class → quadratic boundary\n",
    "\n",
    "from scipy.stats import multivariate_normal\n",
    "\n",
    "def fit_qda(X, y):\n",
    "    idx0, idx1 = y == 0, y == 1\n",
    "    phi = idx1.sum() / len(y)\n",
    "    mu0 = X[idx0].mean(axis=0)\n",
    "    mu1 = X[idx1].mean(axis=0)\n",
    "    d0 = X[idx0] - mu0\n",
    "    d1 = X[idx1] - mu1\n",
    "    Sigma0 = (d0.T @ d0) / idx0.sum()\n",
    "    Sigma1 = (d1.T @ d1) / idx1.sum()\n",
    "    return phi, mu0, mu1, Sigma0, Sigma1\n",
    "\n",
    "def qda_predict(X, phi, mu0, mu1, Sigma0, Sigma1):\n",
    "    log_p0 = multivariate_normal.logpdf(X, mu0, Sigma0) + np.log(1 - phi)\n",
    "    log_p1 = multivariate_normal.logpdf(X, mu1, Sigma1) + np.log(phi)\n",
    "    return (log_p1 > log_p0).astype(int)\n",
    "\n",
    "# New dataset: different Sigma per class\n",
    "Sigma0_true = np.array([[0.5, 0.0], [0.0, 2.0]])\n",
    "Sigma1_true = np.array([[2.0, 0.0], [0.0, 0.5]])\n",
    "\n",
    "X0 = np.random.multivariate_normal([1.0, 2.5], Sigma0_true, 80)\n",
    "X1 = np.random.multivariate_normal([4.0, 2.5], Sigma1_true, 80)\n",
    "Xq = np.vstack([X0, X1])\n",
    "yq = np.array([0]*80 + [1]*80)\n",
    "\n",
    "# Fit GDA and QDA on this data\n",
    "phi_l, mu0_l, mu1_l, Sigma_l = fit_gda(Xq, yq)\n",
    "phi_q, mu0_q, mu1_q, Sigma0_q, Sigma1_q = fit_qda(Xq, yq)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "xx, yy = np.meshgrid(np.linspace(-2, 7, 300), np.linspace(-1, 6, 300))\n",
    "grid = np.c_[xx.ravel(), yy.ravel()]\n",
    "\n",
    "for ax, (title, preds) in zip(axes, [\n",
    "    (\"GDA (Linear boundary)\", gda_predict(grid, phi_l, mu0_l, mu1_l, Sigma_l).reshape(xx.shape)),\n",
    "    (\"QDA (Quadratic boundary)\", qda_predict(grid, phi_q, mu0_q, mu1_q, Sigma0_q, Sigma1_q).reshape(xx.shape)),\n",
    "]):\n",
    "    ax.scatter(X0[:,0], X0[:,1], c='orange', marker='o', alpha=0.6, edgecolors='k', s=30, label='Class 0')\n",
    "    ax.scatter(X1[:,0], X1[:,1], c='gray', marker='s', alpha=0.6, edgecolors='k', s=30, label='Class 1')\n",
    "    ax.contour(xx, yy, preds, levels=[0.5], colors='red', linewidths=2, linestyles='--')\n",
    "    ax.set_title(title, fontsize=12)\n",
    "    ax.set_xlim(-2, 7); ax.set_ylim(-1, 6)\n",
    "    ax.legend(fontsize=9); ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle('GDA vs QDA: Shared vs. Per-Class Covariance', fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"GDA forces a line. QDA finds the quadratic boundary that better fits each class shape.\")"
